{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'scripts/**/*.test.mjs'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:integration:concurrency": "RUN_DB_INTEGRATION=1 node --test scripts/postgres-concurrency.integration.test.mjs scripts/public-launch-database.integration.test.mjs scripts/production-payment.integration.test.mjs scripts/production-mfa.integration.test.mjs scripts/admin-order-intelligence.integration.test.mjs",
    "validate:startup": "node scripts/validate-startup-env.mjs",
    "start": "node scripts/start.mjs",
    "validate:firebase": "node scripts/validate-firebase-client-env.mjs",
    "build:production": "npm run validate:firebase && vite build",
    "security:deps": "npm audit --audit-level=high",
    "security:signatures": "npm audit signatures",
    "security:ci": "npm run security:deps && npm run security:signatures",
    "load:test": "node scripts/load-test.mjs",
    "release:verify": "npm run validate:startup && npm run security:ci && npm run typecheck && npm run lint && npm test && npm run build:production",
    "providers:configure": "node scripts/configure-payment-providers.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/start-storage-context": "1.167.30",
    "better-auth": "1.7.6",
    "clsx": "^2.1.1",
    "jose": "6.2.9",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "srvx": "0.11.22",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.0",
    "nitro": "3.0.260610-beta"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "version": "1.99.3",
  "engines": {
    "node": "22.x"
  }
}
